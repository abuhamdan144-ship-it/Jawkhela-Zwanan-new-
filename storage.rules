rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Profile Images: User can upload to their own uid folder, anyone can read
    match /profileImages/{userId}_{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.size < 5 * 1024 * 1024 
                    && request.resource.contentType.matches('image/.*');
    }
    
    // Donations: Anyone can upload a receipt, only admins can read
    match /donations/{fileName} {
      allow create: if request.resource.size < 5 * 1024 * 1024 
                    && request.resource.contentType.matches('image/.*');
      // Read access should technically be admin only, but for now we'll restrict to authenticated admins
      allow read: if request.auth != null && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Public content (news, projects, events): Only admins can upload/delete, anyone can read
    match /public/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
